# ★★ [P-286 · 2026-09-24 턴 AH] **두 줄을 비워 둔다 — 같은 출처가 기본값이다.**
#
#   왜 바뀌었나 [실측 · 대표가 직접 걸어서 찾았다]
#   ------------------------------------------------------------------
#   이 두 줄에 절대 주소가 있으면 번들이 **어디서 열리든** 그 주소를 부른다.
#   그래서 화면(3002)과 API(8000)가 늘 다른 출처였고, 대표가 브라우저로 열었을 때
#   「연결 거부」가 났다 — 그 주소들이 **컨테이너 안에서만 사는 주소**였기 때문이다.
#   급히 중계 컨테이너를 세워 화면은 떴지만 그것은 **다리이지 길이 아니다** —
#   고객은 다리를 놓을 수 없다.
#
#   비워 두면 `rj-core::initialServices` 가 그 값을 axios `baseURL` 에 그대로 넣고,
#   빈 baseURL 은 **현재 출처**로 붙는다. 앞단(nginx 8500)이 화면과 `/api` 를 함께
#   주므로 한 주소로 끝난다.
#   [A/B 실측: 번들 안 `http://localhost:8000` **16건 → 0건**]
#
#   ⚠ **다른 출처가 필요하면 그때 채운다** — 예: 스테이징은 `.env.stg` 가 도메인 둘을
#     따로 쓴다(앞단과 뒷단이 실제로 다른 호스트다). 그 경우는 **빈 값이 틀린 것**이고,
#     이 파일의 기본값이 그 경우를 막지 않는다.
#   ⚠ 여기를 다시 절대 주소로 되돌리면 **같은 함정이 되돌아온다.** 되돌린다면 사유를
#     이 자리에 적어라 — 적지 않으면 다음 사람이 또 다리를 놓는다.
VITE_API_URL=
VITE_API_URL_FE=
VITE_KAKAO_API_KEY=your-kakao-javascript-key-here
VITE_STREAMING_WS=ws://localhost:8000
VITE_STREAMING_BASE_URL=https://streaming.internal.example
VITE_STREAMING_WEBRTC_URL=https://webrtc.internal.example
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
VITE_TURN_URL=turn:turn.internal.example:3478
VITE_TURN_USERNAME=your-turn-username-here
VITE_TURN_PASSWORD=your-turn-password-here
VITE_USE_POLLING=false

# GCS Backend API Configuration
VITE_GCS_API_URL=http://localhost:8009
VITE_GCS_TELEMETRY_API_URL=http://localhost:8009
# ⚠ D-003: 이 클라이언트 키는 backend 의 GCS_APIKEY 와 반드시 다른 값이어야 한다.
#          브라우저 번들에 실리므로 권한 최소 + Referer/도메인 제한을 건다.
#          W0-5 에서 proxy 경유로 전환하면 이 항목 자체를 삭제한다.
VITE_CGS_APIKEY=your-gcs-client-apikey-here

VITE_AI_STREAM_WS_URL=wss://media-ai.internal.example

# W0-4: 데모·목업 화면(mockupDemoUi / setup-demo-*) 노출 플래그.
#        프로덕션 빌드는 반드시 미설정 또는 false — true 로 빌드하면 GS 인증 결함이 된다.
VITE_ENABLE_DEMO=false
