  "scripts": {
    "dev": "vite",
    "build": "VITE_USE_POLLING=true tsc --noEmit || true && vite build",
    "type-check": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
