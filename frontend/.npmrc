# 패키지 매니저: npm 정본 (D-006)
#
# D-201(A안) — react@19 와 react-text-mask@5.5.0 의 peer 범위(react ≤18)가 충돌한다.
# react-text-mask 는 frontend/src/components/Form/PhoneNumberInput.tsx 에서 실사용 중이므로
# W0-0(저장소 초기화) 범위에서 라이브러리를 교체하지 않는다.
# 이 플래그로 CI·로컬·Docker 가 동일한 해석 조건을 갖도록 고정한다.
#
# ⚠ 남은 부채: react-text-mask 는 React 19 를 공식 지원하지 않는다.
#   PhoneNumberInput 화면의 실동작 확인이 별도로 필요하며,
#   라이브러리 교체는 별도 티켓으로 올린다 (W0-7 초안 — 사람 승인 대기).
legacy-peer-deps=true
