# 저장소 뿌리 .env — **이름만** 여기 있고 값은 여기 없다 (D-204 · P-5)
#
# `docker compose` 는 저장소 뿌리의 `.env` 를 **자동으로** 읽는다. 그 파일은
# `.gitignore` 가 잡는다(`.env`). 이 파일(`.env.example`)은 그 짝으로, **무엇을
# 채워야 하는지**만 말한다.
#
# ⚠ 여기에 실값을 적지 않는다. `gate_secrets` 가 이 파일을 훑고, 값이 플레이스홀더
#   형식이 아니면 exit 1 한다. 그 게이트는 이 줄을 지키라고 있는 것이다.
#
#   cp .env.example .env      # 그리고 아래 값을 채운다
#   docker compose up -d minio

# ── MinIO (객체 저장소) ─────────────────────────────────────────────────────
# ★ 기본값을 두지 않는다. compose 가 `${MINIO_ROOT_USER:?…}` 로 받으므로 비면
#   **조용히 기본 자격증명으로 서는 대신 그 자리에서 멈춘다.** 기본 자격증명으로 선
#   저장소는 열려 있는 저장소다.
# 형식: USER 3자 이상 · PASSWORD 8자 이상 (MinIO 루트 요건)
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_AT_LEAST_8_CHARS

# 백엔드가 쓰는 버킷 이름. 서버의 루트 자격증명과 같은 값을 백엔드에도 준다
# (backend 의 MINIO_ACCESS_KEY / MINIO_SECRET_KEY — backend/.env.example 참조).
MINIO_BUCKET_NAME=guardianx-dev

# ── 앱쪽 MinIO 이름 셋 — **여기에 없어서 `gx-shell` 이 `dummy` 로 서 있다** ──
#   (P-108 가지 B · 2026-09-07 턴 M · 차선 E 실측)
#
# ★ 서버쪽 이름(위 MINIO_ROOT_*)과 앱쪽 이름은 **다른 이름**이다. 앱은
#   `backend/config/settings.py:789-799` 에서 아래 셋을 읽는다. 이 파일에는
#   서버쪽 셋만 있고 앱쪽 셋이 **한 칸도 없다** — 그래서 손으로 만든 컨테이너마다
#   무엇이 들어갔는지가 갈렸다 [실측 · 값은 안 적고 minio 루트와 **같은가**만 잰다]:
#       gx-gunicorn-e · gx-celery-e · gx-beat-e   ENDPOINT=minio:9000  · 실자격증명 (일치)
#       gx-shell                                  ENDPOINT=minio.invalid · ACCESS/SECRET = `dummy`
#   `gx-shell` 안의 runserver:8000 이 「주 서버」이고, 그것이 /api/media-data 에
#   503 을 내던 자리다. 코드는 멀쩡하다 — 같은 코드가 gunicorn 뒤에서는 900건
#   무오류로 미디어를 낸다 [OPS-13b 재확인 실측 2026-09-07].
#
# ⚠ **마운트된 파일로는 못 고친다.** `settings.py:25` 의
#   `environ.Env.read_env(BASE_DIR/.env)` 는 `setdefault` 라 **프로세스 환경이 이긴다**.
#   `gx-shell` 은 이미 프로세스 환경에 `dummy` 를 **갖고** 있으므로,
#   `/app/.env`(=`backend/.env`)에 무엇을 적어도 비켜서지 않는다.
#   고치는 자리는 `docker run --env-file` 이 읽는 **이 파일**이고, 굳는 때는
#   **컨테이너 재생성**뿐이다 (대표 결정 ③).
#
# ⚠ 값의 모양 (`--env-file` 규약): `${...}` 를 **펴 주지 않는다**. 따옴표도
#   벗기지 않는다. 그러니 아래 둘은 위 MINIO_ROOT_* 와 **같은 글자를 그대로**
#   다시 적어야 한다 — `${MINIO_ROOT_USER}` 라고 적으면 그 여덟 글자가 계정이 된다.
#
# MINIO_ENDPOINT=<minio 서비스 이름>:9000      # 스킴(http://) 없이 host:port
# MINIO_ACCESS_KEY=<위 MINIO_ROOT_USER 와 같은 글자>
# MINIO_SECRET_KEY=<위 MINIO_ROOT_PASSWORD 와 같은 글자>
# MINIO_USE_HTTPS=False                       # 개발 형상 (평문 9000)

# ── 운영 프로필 선언 (P-75 · SEC-18 · 2026-09-06 턴 H) ──────────────────────
# ★ **보안 설정의 기본값은 닫힌 쪽이고, 열린 값은 선언으로만 열린다.**
#   턴 G 실측: 아무 선언 없이 뜨면 `SECRET_KEY` 는 저장소에 적힌 자리표,
#   `DEBUG=True`, `ALLOWED_HOSTS=["*"]`, 쿠키는 평문이었다. 그것을 보는 게이트가
#   저장소에 **0건**이었다. 공개 URL 을 여는 순간 트레이스백·호스트 무제한·세션 위조다.
#
# ⚠ 순서를 지킨다(P-67 이 보존 일수에서 밟은 그 순서):
#   ① 이 파일에 **이름** → ② 로컬 `.env` 에 **값** → ③ `settings_prod` 배선
#   → ④ 재기동 창 → **그 다음에야** 코드의 열린 기본값을 지운다.
#   뒤집으면 `DJANGO_SECRET_KEY` 가 없는 지금 컨테이너들이 settings 를 읽는
#   순간 죽는다 — 개발 환경 전체가 안 뜬다.
#
# ⚠ `deploy.sh` 는 **prod 프로필에서만** 스테이징·운영에 올린다. 개발 프로필로
#   공개 URL 을 열려고 하면 배치가 거부된다. `verify_prod_settings.py` 5/5 가
#   초록이 아니면 URL 을 열지 않는다 — 그것이 RC-1 의 전제다.

# 서명 키. **자리표를 금지한다** — 없으면 운영 프로필은 기동을 거부한다.
# 형식: 50자 이상 무작위. 만드는 법: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME_AT_LEAST_50_RANDOM_CHARS

# 개발에서만 true. 운영 프로필은 이 값을 **읽지 않고 False 로 고정**한다.
DJANGO_DEBUG=false

# 쉼표로 나눈 호스트 목록. `*` 는 운영 프로필에서 **거부**된다.
# 예: guardianx.example.kr,stg.guardianx.example.kr
DJANGO_ALLOWED_HOSTS=CHANGE_ME_COMMA_SEPARATED_HOSTS

# CSRF 가 믿는 출처. 스킴을 포함해야 한다(Django 4+ 요건).
# 예: https://guardianx.example.kr
DJANGO_CSRF_TRUSTED_ORIGINS=CHANGE_ME_WITH_SCHEME

# ── AI 분석 서버 콜백 키 (D-370 · 턴 I 등재 · 2026-09-06) ────────────────────
# ★ **배치를 막는 이름인데 이 파일에 없었다.** `scripts/verify_deploy_ready.py`
#   가 `REQUIRED_BEFORE_DEPLOY` 로 이 이름 하나를 막고 있는데, 「어디에 무엇을
#   넣어야 하는가」가 저장소 어디에도 적혀 있지 않았다 [실측 2026-09-06 턴 I].
#   막는 이름은 **푸는 법과 같은 자리에** 있어야 한다 — 아니면 그 관문은
#   막기만 하고 아무도 통과시키지 못한다.
#
# 무엇이 깨지나: AI 분석 서버가 `/api/media-data/detect-callback` ·
#   `/api/media-data/upload-detection` 을 부를 때 쓰는 공유 비밀이다. 없으면
#   **검출 결과 콜백이 401 로 조용히 끊긴다** — 아무도 안 죽으므로 아무도 모른다.
#   재난 검출 본선(gRPC)은 살아 있고 **미디어 분석만** 멈춘다.
#
# ⚠ 이 값은 **양쪽이 같아야 한다** — 우리 `.env` 와 AI 분석 서버의 설정.
#   그래서 우리가 혼자 정할 수 없다: 스테이징을 열 때 **양쪽이 같이** 세운다.
# 만드는 법: python -c "import secrets;print(secrets.token_urlsafe(48))"
INBOUND_AI_CALLBACK_KEY=CHANGE_ME_SHARED_WITH_AI_SERVER

# ── 경보 발송처 (OPS-10 · 턴 I 등재 · 2026-09-06) ────────────────────────────
# ★ **발송 경로와 운영 수신처는 다른 칸이다.** 턴 I 에 차선 E 가 발송 경로를
#   끝까지 태워 실제로 한 통을 보냈다(mailpit 수신 실증 ·
#   `docs/agent/evidence/OPS-10/경보_실발사_20260906_TI.md`). 운영 수신처 주소만
#   대표 결정 대기다. 둘을 한 칸으로 뭉개면 「경보가 0」으로 읽히는데 사실이 아니다.
#
# ⚠ **`K2_SEND_ALLOWED_DOMAINS` 한 줄이 개발 계정 30명을 막는다.** 이 줄이 없으면
#   개발 DB 의 사람 주소(yopmail 24 · seed.invalid 6)로 **진짜 메일이 나간다.**
#   허용목록 밖은 발송하지 않고 그 사유를 `DeliveryRecord` 행에 남긴다 —
#   차선 E 가 음성 대조군으로 실증했다(허용목록 밖 → 수신함 총량 불변).
#
# ⚠ 값은 로컬 `.env` 에 넣고, **적용은 재기동 창에서** 한다. 이미 뜬 컨테이너에는
#   닿지 않는다(로그 상한과 같은 자리 · RUNBOOK STEP 2B).
EMAIL_HOST=CHANGE_ME_SMTP_HOST          # 개발: mailpit
EMAIL_PORT=CHANGE_ME_SMTP_PORT          # 개발: 1025
EMAIL_USE_TLS=false                     # 개발 mailpit 은 평문. 운영은 true
EMAIL_HOST_USER=CHANGE_ME_SENDER
EMAIL_HOST_PASSWORD=CHANGE_ME_SENDER_SECRET
DEFAULT_FROM_EMAIL=CHANGE_ME_SENDER
# 쉼표로 나눈 **허용 수신 도메인**. 비우지 말 것 — 비면 아무도 안 막는다.
K2_SEND_ALLOWED_DOMAINS=CHANGE_ME_COMMA_SEPARATED_DOMAINS
K2_ALERT_CHANNEL=email

# ── 백업 목적지 (P-102 · OPS-12a · 2026-09-07 턴 K) ──────────────────────────
# ★ **이 이름이 없어서 백업 주기가 두 벌(정확히 24시간 간격) 돌고도 회수증이
#   0장이었다** [실측 2026-09-07]. `backend/config/settings.py` 가
#   `env.str("OPS_BACKUP_DIR", default="")` 로 읽는데 아무도 선언하지 않아 빈
#   문자열이었고, `backend/config/retention_seed.py` 는 `/backup` 을 기대한다.
#
# ⚠ **이 칸에는 실값을 적어도 된다 — 경로는 비밀이 아니다.** 이 파일의 규약
#   「값은 여기 없다」는 **비밀**에 대한 것이고(D-204), 경로는 비밀이 아니라 형상이다.
#   비밀이 아닌 것을 자리표로 가리면 다음 사람이 무엇을 넣을지 몰라 빈칸으로 둔다 —
#   그것이 바로 이번에 일어난 일이다.
#
# ⚠ 값을 바꾸려면 `docker-compose.yml` 의 `gx_backup_vault_e:/backup` 마운트도
#   같이 옮겨야 한다. 경로만 바꾸면 컨테이너 루트의 평범한 폴더에 백업이 떨어지고
#   **「파일이 생겼다」가 초록으로 보인다** (compose 의 celery 절 주석 참조).
#   그리고 마운트는 컨테이너를 **다시 만들 때** 굳는다 — 재기동 창이 필요하다.
OPS_BACKUP_DIR=/backup

# ── 백업 주기 스위치 — **이름만 둔다. 값은 여기서 주지 않는다** ──────────────
#   (P-102 · 턴 K 가 넷째 결함으로 세웠고, **턴 M 이 그 진단을 고쳤다**)
#
# ★ 턴 K 의 진단은 절반이 틀렸다 [실측 2026-09-07 턴 M · `gx-celery-e` 안에서]:
#     · 틀린 절반 — 「`settings.py:916` 의 기본값이 False 이고 **아무도 선언하지
#       않았다**」. 아니다. `settings.py:1276` 이 `config/retention_seed.py` 를
#       읽어 `development`·`staging` 에서 이 값을 **True 로 이미 선언**하고 있고,
#       같은 컨테이너에서 새 인터프리터를 띄우면 그대로 True 가 나온다:
#           docker exec gx-celery-e python -c "...; print(settings.OPS_BACKUP_SCHEDULE_ENABLED)"
#           → True   ·   OPS_BACKUP_DIR → '/backup'
#     · 맞은 절반 — 주기는 **정말로 건너뛰고 있었다**(verdict='SKIPPED').
#   두 사실이 어긋나지 않는 이유는 하나다: **꺼져 있던 것은 설정이 아니라 프로세스**다.
#   워커는 2026-09-05 11:07(UTC)에 떴고 시드는 2026-09-06 19:54 에 들어왔다 —
#   그 사이의 코드를 메모리에 든 채로 24시간 간격 두 벌을 돌았다. 파일을 고쳐도
#   **이미 뜬 파이썬은 다시 읽지 않는다.** 고치는 자리는 `.env` 가 아니라 **재기동**이었다.
#   → 턴 M 이 `docker restart gx-celery-e` 로 껐다 켰고, 그 뒤 같은 태스크의 판정이
#     `SKIPPED` → `UNKNOWN`(보관처가 별도 볼륨이 아니다)로 **바뀌었다.** 스위치는 켜졌다.
#
# ⚠ **그래서 이 줄에 값을 주지 않는다** — 주면 그 순간 이것이 시드를 이긴다.
#   `settings.py` 는 `os.environ` 에 이름이 있으면 시드를 비켜서게 만든다
#   (P-67 · `retention_seed.declarations()` 의 `already_declared`). 이 파일을
#   그대로 `cp .env.example .env` 하는 사람이 **운영 형상에서도** 백업 주기를
#   켜 버리게 되고, P-67 은 「운영은 고객이 U5 화면에서 선언한다」고 정했다.
#   개발·스테이징은 **이미 켜져 있다. 여기서 다시 켤 것이 없다.**
#
# ⚠ 이 이름을 **굳이** 쓸 자리는 하나뿐이다: 시드가 켠 것을 **끄고 싶을 때**
#   (`false`). 그때만 아래 줄의 주석을 벗긴다.
# OPS_BACKUP_SCHEDULE_ENABLED=false

# ── 저장 용량 상한 (P-139 · 2026-09-15 턴 Q · 차선 E) ─────────────────────────
# ★ **비밀이 아니다 — 형상이다**(위 OPS_BACKUP_DIR 과 같은 규약). 그래서 실값을 적는다.
#   `scripts/ops_monitor.py:89` 의 이름을 `:305` 가 `os.environ` 에서 읽는다. 없거나 0 이면
#   `storage_used_pct` 는 UNKNOWN 이다(`:329-334` · D-301 — 분모를 코드가 지어내지 않는다).
# 값 = 실측 가용 × 0.8 · 정수 GB(1024³ — ops_monitor 가 쓰는 단위) [판정 P-139]
#   재는 자리가 둘이고 **작은 쪽**을 쓴다 [실측 2026-09-15 · df]:
#     · minio `/data` 볼륨   가용 935.9GiB — Docker Desktop 가상 디스크의 **명목** 크기
#     · 그 가상 디스크(docker_data.vhdx)가 사는 호스트 C:   가용 62.5GiB — **실제로 찰 수 있는** 크기
#   62.5 × 0.8 = 50. 명목(748)을 쓰면 C: 가 차는 날에도 %는 한 자리 수를 말한다.
#   근거: docs/agent/evidence/P-139/storage_cap_20260915.md
# ⚠ **이 줄은 도는 감시에 닿지 않는다.** 뿌리 `.env` 는 compose 만 읽고 gx-* 는 손으로 만든
#   컨테이너다. 닿는 길은 둘 — `backend/.env`(settings.py:25 read_env · 프로세스 재시작) 또는
#   재생성 창의 env-file. 절차: docs/agent/RUNBOOK_재생성창.md 「⑤ 반영」.
GX_STORAGE_CAPACITY_GB=50

# ── 앱 DB 역할 분리 — **이름만 둔다. 값은 대표 결정이다** ────────────────────
#   (OPS-23 · 세종 P-178 → P-187 · 2026-09-19 턴 W · 차선 U56)
#
# ★ 지금 앱은 **superuser 로 돈다** [실측 2026-09-19 · 개발 DB]:
#     current_user = postgres  ·  rolsuper=t · rolcreatedb=t · rolcreaterole=t
#     public 스키마 표 231  ·  로그인 가능한 superuser 둘(postgres · pgroot)
#     역할 gx_app · gx_migrate 는 **아직 없다**(0개 — 이 턴에 만들지 않았다)
#   그 말은 앱 코드 한 줄이 `DROP TABLE` 을 할 수 있다는 뜻이다. 나누는 것이 OPS-23.
#
# ★ 나눈 뒤의 모양 — **역할 둘**:
#     gx_app      앱·celery·beat 가 쓴다. DDL **없음**(NOCREATEDB · 스키마 USAGE 만).
#     gx_migrate  마이그레이션만. 표를 만드는 쪽이고, 그쪽의 DEFAULT PRIVILEGES 가
#                 앞으로 태어나는 표에 gx_app 의 DML 을 붙여 준다.
#   SQL 전문: docs/agent/evidence/P-178/p178_app_db_roles.sql (**아직 안 돌렸다**)
#   영향 조사 7가지 · compose diff: docs/agent/evidence/P-178/dry_run.md
#
# ⚠ **아래 넷은 이름뿐이다 — 값을 여기 적지 않는다.** 비밀번호는 D-204 상 이 파일에
#   올 수 없고, 실제 값을 뿌리 `.env` 에 넣는 것은 **대표 결정**이다.
# ⚠ compose 는 이 이름들을 `${DB_APP_USER:?...}` 로 읽을 계획이다 — 없으면 **멈춘다.**
#   기본값을 `postgres` 로 두지 않는 이유: 「분리했다」고 적힌 채 그대로 superuser 로
#   도는 날이 오고, 그 상태는 지금보다 **나쁘다**(사람이 믿게 되므로).
# ⚠ 이 넷을 채워도 **컨테이너를 다시 만들어야** 적용된다(`environment:` 는 restart 로
#   안 먹는다). 절차: docs/agent/RUNBOOK_재생성창.md
# DB_APP_USER=gx_app
# DB_APP_PASSWORD=CHANGE_ME_APP_DB_SECRET
# DB_MIGRATE_USER=gx_migrate
# DB_MIGRATE_PASSWORD=CHANGE_ME_MIGRATE_DB_SECRET
