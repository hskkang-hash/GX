# 저장소 뿌리 .env — **이름만** 여기 있고 값은 여기 없다 (D-204 · P-5)
#
# `docker compose` 는 저장소 뿌리의 `.env` 를 **자동으로** 읽는다. 그 파일은
# `.gitignore` 가 잡는다(`.env`). 이 파일(`.env.example`)은 그 짝으로, **무엇을
# 채워야 하는지**만 말한다.
#
# ⚠ 여기에 실값을 적지 않는다. `gate_secrets` 가 이 파일을 훑고, 값이 플레이스홀더
#   형식이 아니면 exit 1 한다. 그 게이트는 이 줄을 지키라고 있는 것이다.
#
#   cp .env.example .env      # 그리고 아래 값을 채운다
#   docker compose up -d minio

# ── MinIO (객체 저장소) ─────────────────────────────────────────────────────
# ★ 기본값을 두지 않는다. compose 가 `${MINIO_ROOT_USER:?…}` 로 받으므로 비면
#   **조용히 기본 자격증명으로 서는 대신 그 자리에서 멈춘다.** 기본 자격증명으로 선
#   저장소는 열려 있는 저장소다.
# 형식: USER 3자 이상 · PASSWORD 8자 이상 (MinIO 루트 요건)
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_AT_LEAST_8_CHARS

# 백엔드가 쓰는 버킷 이름. 서버의 루트 자격증명과 같은 값을 백엔드에도 준다
# (backend 의 MINIO_ACCESS_KEY / MINIO_SECRET_KEY — backend/.env.example 참조).
MINIO_BUCKET_NAME=guardianx-dev

# ── 운영 프로필 선언 (P-75 · SEC-18 · 2026-09-06 턴 H) ──────────────────────
# ★ **보안 설정의 기본값은 닫힌 쪽이고, 열린 값은 선언으로만 열린다.**
#   턴 G 실측: 아무 선언 없이 뜨면 `SECRET_KEY` 는 저장소에 적힌 자리표,
#   `DEBUG=True`, `ALLOWED_HOSTS=["*"]`, 쿠키는 평문이었다. 그것을 보는 게이트가
#   저장소에 **0건**이었다. 공개 URL 을 여는 순간 트레이스백·호스트 무제한·세션 위조다.
#
# ⚠ 순서를 지킨다(P-67 이 보존 일수에서 밟은 그 순서):
#   ① 이 파일에 **이름** → ② 로컬 `.env` 에 **값** → ③ `settings_prod` 배선
#   → ④ 재기동 창 → **그 다음에야** 코드의 열린 기본값을 지운다.
#   뒤집으면 `DJANGO_SECRET_KEY` 가 없는 지금 컨테이너들이 settings 를 읽는
#   순간 죽는다 — 개발 환경 전체가 안 뜬다.
#
# ⚠ `deploy.sh` 는 **prod 프로필에서만** 스테이징·운영에 올린다. 개발 프로필로
#   공개 URL 을 열려고 하면 배치가 거부된다. `verify_prod_settings.py` 5/5 가
#   초록이 아니면 URL 을 열지 않는다 — 그것이 RC-1 의 전제다.

# 서명 키. **자리표를 금지한다** — 없으면 운영 프로필은 기동을 거부한다.
# 형식: 50자 이상 무작위. 만드는 법: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME_AT_LEAST_50_RANDOM_CHARS

# 개발에서만 true. 운영 프로필은 이 값을 **읽지 않고 False 로 고정**한다.
DJANGO_DEBUG=false

# 쉼표로 나눈 호스트 목록. `*` 는 운영 프로필에서 **거부**된다.
# 예: guardianx.example.kr,stg.guardianx.example.kr
DJANGO_ALLOWED_HOSTS=CHANGE_ME_COMMA_SEPARATED_HOSTS

# CSRF 가 믿는 출처. 스킴을 포함해야 한다(Django 4+ 요건).
# 예: https://guardianx.example.kr
DJANGO_CSRF_TRUSTED_ORIGINS=CHANGE_ME_WITH_SCHEME
