    "permissions": "Based on user roles and menu/tab permissions",
    "unique_constraint": "Combination of menu_id, tab_id, name, and group_id must be unique",
    "menu_tab_group_integration": "Links directly to core Menu, Tab, and UserGroup system for maximum flexibility",
    "response_format": "All responses follow BaseResponse format with status_code, message, data, success fields",
    "error_handling": "Errors include ValidationError with detailed field-level messages",
    "multilingual_support": "Messages support multiple languages via MESSAGE_ENUM constants",
    "data_flow": "send_data=true means system sends data to external API, receive_data=true means system receives data from external API",
    "another_info": "Field for storing additional information from external APIs that don't have corresponding keys in the system",
