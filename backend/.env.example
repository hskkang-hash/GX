# Django
DJANGO_SECRET_KEY=your-super-secret-key-for-dev
DJANGO_DEBUG=True

# W0-10: 배포처 origin 목록. 콤마로 구분한다.
#        settings.py 기본값은 로컬 개발 2개(localhost:8000, 127.0.0.1:8000)뿐이므로
#        실제 배포 주소(관제센터 IP·공개 도메인)는 반드시 여기에 채워야 CSRF 가 통과한다.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://api.your-deployment.example

# Domain Backend
BACKEND_URL=http://localhost:8000

GUARDIANX_ENVIRONMENT="development"

# Database
DB_NAME=database_stg_idc_20
# P-18 차선별 시험 DB 이름. 비우면 Django 기본(test_ + DB_NAME).
# 병렬 차선은 여기를 가른다: test_gx_c · test_gx_d · test_gx_e · test_gx_v
DB_TEST_NAME=
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_HOST=db.internal.example
DB_PORT=5432

# Redis
REDIS_HOST='redis://redis:6379'
REDIS_DB=0

# MinIO
MINIO_ENDPOINT=minio.internal.example
MINIO_ACCESS_KEY=your-minio-access-key-here
MINIO_SECRET_KEY=your-minio-secret-key-here
MINIO_BUCKET_NAME=guardianx-dev
MINIO_USE_HTTPS=True

# Email
SMTP_SERVER="smtp.gmail.com"
SENDER_EMAIL="your-sender-email-here"
SMTP_PORT=587
SMTP_USERNAME="your-smtp-username-here"
SMTP_PASSWORD="your-smtp-app-password-here"

# GCS
# ⚠ D-003: 이 서버 키는 frontend 의 VITE_CGS_APIKEY 와 반드시 다른 값이어야 한다.
#          동일 값 사용 시 W0-1a 의 시크릿 스캔 커스텀 룰에서 FAIL 처리된다.
GCS_APIKEY=your-gcs-server-apikey-here
FLIGHTBRID_URL=http://localhost:8009


# OpenSearch
OPENSEARCH_HOST="https://opensearch.internal.example"
OPENSEARCH_USERNAME="your-opensearch-username-here"
OPENSEARCH_PASSWORD="your-opensearch-password-here"
OPENSEARCH_INDEX="gcs_phat"

# Kakao
KAKAO_API_KEY="your-kakao-rest-api-key-here"
# JavaScript 키 (지도 SDK용). REST 키와 다른 값이다.
KAKAO_JS_API_KEY="your-kakao-javascript-key-here"
KAKAO_GEOCODING_URL="https://dapi.kakao.com/v2/local/search/keyword.json"

# Anyang
ANYANG_SERVICE_KEY="your-anyang-service-key-here"

# Streaming
STREAM_URL="https://streaming.internal.example"
RTSP_URL="rtsp://rtsp.internal.example:8554"
AI_RTSP_PATH="https://ai.internal.example/api/process_stream"
IS_USE_WEBRTC=True
AI_GRPC_URL="https://media-ai.internal.example"

# AI Analysis
AI_ANALYSIS_URL="https://ai-analysis.internal.example"

# 테넌트 스코프 강제 (W0-14). false=경고 모드(차단 없이 로그만) / true=차단 모드
TENANT_SCOPE_ENFORCE=false

# 전역 관리 역할 (W0-16 · D-243). GAION 운영자 전용 역할 코드 — 이 역할만 테넌트 경계를 넘는다
TENANT_GLOBAL_ADMIN_ROLE_CODES=gaion_global_admin
# 레거시 superuser 역할을 아직 전역으로 인정할 것인가. 대체역할 부여 완료 후 false 로 내린다
# 절차: docs/agent/evidence/W0-16/revocation_runbook.md
TENANT_TRUST_LEGACY_SUPERUSER=true
# 테넌트 운영 역할 코드 접두어 — <prefix>_<group_id> 규약
TENANT_ADMIN_ROLE_PREFIX=tenant_admin


# ─────────────────────────────────────────────────────────────────────────────
# K2 경보 이메일 — OPS-10 「발송까지 · 수신 대기」 (2026-09-24)
# ─────────────────────────────────────────────────────────────────────────────
# ⚠ **여기에 실값을 적지 않는다.** 이름만 있다(D-204). 값은 로컬 `.env` 로만 온다.
#
# [실측 2026-09-24] `config/settings.py` 의 EMAIL_* 기본값은 **자리 표시자**다
# (`your-email@gmail.com` · `your-app-password`). 그 값으로 SMTP 는 서지 않는데,
# `getattr` 로 읽으면 **값이 있다**로 보인다 — 그래서 「설정 안 함」과 「설정했는데
# 틀림」이 같은 모양이 된다. `kernels/k2_notify/channels.py::EmailChannel.configured()`
# 가 그 자리 표시자를 알아보고 **회색(미설정)** 이라고 말한다. 회색은 초록이 아니다.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# 규칙이 기본으로 고를 채널. `log` 는 **사람이 아니라 로그에 도달한다** —
# 지금 값이 `log` 인 동안 사람에게 도달하는 경보는 0건이다.
# 값을 바꾸는 것만으로 규칙이 바뀌지는 않는다. 규칙을 다시 세우는 것은 이 명령이다:
#   python manage.py seed_alert_routing --user gxprobe_e2e
K2_ALERT_CHANNEL=log

# 경보를 받을 사람의 주소(쉼표로 여럿). **대표가 준다.** 저장소에는 이름만 있다.
# ⚠ [실측 2026-09-05 · 턴 B] 규칙이 고르는 수신자 42명의 도메인: yopmail.com 24 ·
#   org.kr 12 · seed.invalid 6. **비워 두지 않고 채널만 켜면 개발 계정 12명에게
#   진짜로 나간다.** 주소를 넣는 것과 보낼 사람을 정하는 것은 다른 일이다.
K2_ALERT_EMAIL_TO=

# ── 실발송 허용 도메인 (P-41 · 2026-09-05 턴 C) ─────────────────────────────
# ★★ **이 목록이 채널보다 앞에 선다.** 채널이 `email` 이어도 **목록 밖 도메인은
#   로그 어댑터로 강제**된다 — 「보내기로 정했다」와 「이 사람에게 보내도 된다」는
#   다른 판단이고, 뒤엣것을 앞엣것이 대신하게 두면 첫 발송이 곧 사고다.
#
# ★ 왜 「차단 목록」이 아니라 「허용 목록」인가 — 막을 것을 세는 방식은 **새로 생긴
#   개발 계정을 자동으로 통과시킨다.** 오늘 42명을 다 적어도 내일 43번째가 들어온다.
#   허용 목록은 반대로 **모르는 것을 기본으로 막는다.** 실수의 방향이 안전한 쪽이다.
#
# 비어 있으면 **아무 도메인도 실발송하지 않는다**(전부 로그) — 「목록을 잊었다」가
# 「전부 허용」이 되지 않게. 강제: `scripts/verify_send_allowlist.py` (목록 밖 실발송 0)
K2_SEND_ALLOWED_DOMAINS=

# 운영 경보(`ops_monitor` exit 1)를 받는 역할. **U5 시스템관리자만**(P-41) —
# 당직 관제요원에게 디스크 사용률을 보내면 그 사람은 할 수 있는 일이 없고,
# 다음부터 경보를 안 읽는다. 재난 알림(K2)은 이 값이 아니라 **등급 규칙**이 고른다.
K2_OPS_ALERT_ROLE_CODES=
# 웹푸시 VAPID (P-160 · 턴 T · 2026-09-17) — 우리가 만드는 자격은 우리가 만든다.
#   값은 저장소 밖 C:\GuardianX-vault\webpush/vapid_YYYYMMDD.env 에만 있다(이름만 여기).
#   공개키 87자(base64url · 65바이트 점) · 비밀키 43자(base64url · 32바이트) · subject 는 mailto: 주소.
#   읽는 곳: backend/kernels/k2_notify/channels.py::WebPushChannel · apps/dsm/notify_prefs.py
GX_VAPID_PUBLIC_KEY=
GX_VAPID_PRIVATE_KEY=
GX_VAPID_SUBJECT=



# ============================================================================
# 외부 공공데이터 API  (D-298 — 대표 발급 29종 중 제품 기능 관련 11종만 등재)
# ----------------------------------------------------------------------------
# ★ 실값을 여기 넣지 않는다 (D-204). 변수 이름과 설명만 둔다.
#   실값은 C:\GuardianX-vault\ → 로컬 .env (gitignore 대상) 로 가고,
#   verify_secrets 게이트가 실값 커밋을 exit 1 로 막는다.
#   대표님 지시는 "env 파일에 기록" 이었고, 결과는 같으며 안전만 더해진다.
#
# ★ 엔드포인트가 빈 값인 것은 **아직 실측하지 못한 것**이다. 추정으로 채우지 않는다
#   (D-280). 확인 전에는 빈 값으로 두고 **어댑터를 만들지 않는다.**
#
# ★ 코드 착수 시점은 K7 구간(2027.2)이다. 예외는 FX-5(주소 변환) 하나 —
#   F-10 알림·F-11 보고서의 완성도에 직결하므로 K4 완료 후 즉시 착수 가능(D-298).
#
# ★★ D-316 — **「문서에 있다」가 아니라 「계정에서 보았다」로만 등재한다** (2026-09-04)
#   경위: 우리는 대표께서 주신 API 목록 **문서**를 근거로 여기 자리를 잡았다. 그 문서는
#   "받을 수 있는 것" 의 목록이었지 **"받은 것" 의 목록이 아니었다.** 활용신청 현황
#   18건 전수 실측 결과 **셋이 계정에 없다**(DISASTER_CCTV · NLPRK_SAFETY · CHILDCARE_SAFETY).
#   D-292(내 판단의 근거가 실측이 아니라 문서였던 사건)와 **같은 얼굴**이고, 이번엔
#   외부 자원에서 났다.
#
#   그래서 항목마다 근거를 단다:
#       # source: account_verified (2026-09-04 활용신청 현황 18건 실측)
#       # source: doc_only        ← **어댑터 금지**
#       # status: not_applied | not_required   ← 신청 안 됨 / 신청 불필요로 판정됨
#   `scripts/verify_external_sources.py` 가 `doc_only` 항목을 참조하는 어댑터가 있으면 exit 1,
#   그리고 항목 수 · account_verified 수 · doc_only 수를 **건수로 출력**한다(D-301).
# ============================================================================

# ── P0 · 재난 판정에 직접 쓰이는 것 ─────────────────────────────────────────

# 기상청 API허브 (apihub.kma.go.kr) — 포털과 **별도 계정·별도 키**
# 용도: FX-1 건조특보+연기=심각 상향 / FX-2 호우특보+수위 선제 경계
# source: account_verified (2026-09-04 활용신청 현황 18건 실측 — 기상특보 조회서비스)
KMA_APIHUB_KEY=

# 공공데이터포털 (data.go.kr) 일반 인증키 — 아래 포털 API 전부 공통 1개
# 인코딩본(%2B·%3D%3D 포함)과 디코딩본 둘 다 둔다. 라이브러리에 따라 쓰는 쪽이 다르다.
# source: account_verified (2026-09-04 · 18건 전건 승인)
DATA_GO_KR_KEY_ENCODED=
DATA_GO_KR_KEY_DECODED=

# 기상청 포털 API 3종 — 엔드포인트는 포털 "활용신청 상세"에서 실측해 채운다
# source: account_verified (2026-09-04 — 기상특보·단기예보·중기예보 전건 승인)
# ⚠ 승인은 확인됐고 **엔드포인트 문자열은 아직 실측 전**이다. 둘은 다른 사실이다 —
#   승인됐다고 URL 을 문서에서 베껴 오면 그것이 D-316 이 금지한 바로 그 일이다.
KMA_WARNING_URL=
KMA_SHORT_FCST_URL=
KMA_MID_FCST_URL=

# 11. CCTV·재난안전정보
# source: doc_only        ← 활용신청 현황 18건에 **없다** (2026-09-04 실측)
# status: not_required    ← D-321 판정. 신청하지 않는다
# ★ 왜 안 하나 — 포털의 재난안전 CCTV 정보는 **"어디에 CCTV 가 있는지" 의 메타데이터**이지
#   영상이 아니다. 우리는 CCTV 영상을 **직접 받는 회사**다(L1 현장 연계). 설치 위치 목록은
#   우리 기능 어디에도 입력으로 들어가지 않는다.
# ★ 그동안 이것이 잠금으로 남아 있던 이유는 하나다 — **이름이 우리 도메인과 닮아서.**
#   "CCTV·재난안전정보" 는 우리가 하는 일처럼 들린다. 그러나 하는 일이 아니다.
#   **이름의 유사성을 기능의 필요성으로 읽은 것** — 이것도 착시의 한 종류다 (D-321).
DISASTER_CCTV_URL=
DISASTER_CCTV_SERVICE_NAME=

# ── P1 · 컨텍스트·시설·표기 ─────────────────────────────────────────────────

# 9. 주소정보 연계서비스 (juso.go.kr) — 포털과 **별개 계정**
# 용도: FX-5 — F-10 알림 본문과 F-11 보고서 위치란에 사람이 읽는 주소가 들어간다
# source: doc_only  ← 대표께서 승인키 2건 발급을 회신하셨으나 **이 개발 환경에서는 못 봤다**
#                     (vault 2026-02-10판에 juso 없음 · 환경변수 없음 · backend/.env 부재).
#                     문서로 안 것을 계정에서 본 것으로 등재하지 않는다 (D-316).
# ⚠ 그리고 **방향이 미판정이다** (D-318): juso 의 주력은 「검색어→주소」·「주소→좌표」이고
#   FX-5 가 필요한 것은 그 반대(좌표→도로명주소)다. 역방향을 안 주면 키가 와도 안 열린다.
#   판정: `GX_JUSO_API_KEY=... python scripts/probe_juso_direction.py` — 실호출 1회.
# ★ 2026-09-06 판정 종결 (D-329): 발급된 승인키 2건의 API 유형이 **둘 다
#   「도로명주소 팝업 API」**였다 [실측·대표 승인 화면 2건]. 그것은 브라우저 UI 위젯이지
#   서버 조회 API 가 아니다 — **실호출 전에 신청서에서 답이 났다.**
# status: not_required  ← FX-5 는 카메라 설치 주소로 대체됐다 (D-330).
#                         밖에서 사 오려던 것을 우리는 이미 알고 있었다.
JUSO_API_KEY=
JUSO_API_URL=https://business.juso.go.kr/jst/jstRoadNmAddrApiSearch

# 9-b. 도로명주소 **팝업 API** 승인키 2건 — 카메라 주소 입력 UI 용 (D-331)
# 용도: 관리자가 카메라 등록·수정 화면에서 install_address 를 입력할 때 주소검색 팝업.
#       손으로 치면 오타가 나고, 오타 난 주소는 **알림에 그대로 나가 사람을 엉뚱한 곳으로 보낸다.**
# ★ 이것은 **비밀이 아니다.** 팝업 키는 브라우저에서 쓰이므로 애초에 페이지 소스에
#   노출되는 **공개 클라이언트 키**다(D-003 과 같은 갈래). 유일한 방어선은 **등록 URL 제한**.
#   그래도 값은 저장소에 적지 않는다 (D-204 · D-319) — 취급 등급만 프론트엔드 설정값이다.
# source: account_verified (2026-09-06 — 대표 승인 화면 2건. 유형까지 실측했다)
# status: not_applied     ← 아직 이 개발 환경에 넣지 않았다. **막고 있지 않다**(D-332)
# ⚠ 상태·용도의 정본은 K5 표 ②다: backend/kernels/k5_trust/credentials.py
JUSO_POPUP_KEY_1=
JUSO_POPUP_KEY_2=

# 24. 한국천문연구원 특일 정보 — 공휴일·대체공휴일
# 용도: FX-6 휴일 인지 알림 (평일 주간 담당자 ↔ 휴일 당직 그룹 분기)
# source: account_verified (2026-09-04 — 한국천문연구원_특일 정보)
HOLIDAY_API_URL=

# 3./29. 전국초중등학교위치표준데이터 — 대피소·우선보호시설
# source: account_verified (2026-09-04 — 전국초중등학교위치표준데이터)
# status: not_required    ← ★ D-333 재검토(2026-09-06). **밖을 사기 전에 안을 뒤진다.**
#   고객은 특정 지자체이고 보호 대상 시설은 그 지자체가 안다. 카메라는 D-330 으로 자기
#   주소를 갖는다. 전국 학교 좌표는 **우리 계약 AC 어디에도 입력이 아니다** —
#   "F-03 위험구역 자동 제안" 은 계약이 아니라 우리가 붙인 아이디어였다.
#   승인은 살아 있으므로 필요해지면 그때 다시 올린다.
SCHOOL_LOCATION_URL=https://api.data.go.kr/openapi/tn_pubr_public_elesch_mskul_lc_api

# 5. 국립공원 안전정보 — 산악 화재·조난 컨텍스트
