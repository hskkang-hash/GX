# 6. 아동센터·돌봄센터 안전정보 — 취약계층 우선 대피
# source: doc_only        ← 활용신청 현황 18건에 **없다** (2026-09-04 실측)
# status: not_required    ← D-321. 컨텍스트 보강용이지 계약 AC 어디에도 걸리지 않는다
# ★ 대표 문서에 5번과 같은 엔드포인트가 적혀 있었다 — 최소 하나는 다른 API 였다는 뜻이고,
#   실측해 보니 **둘 다 계정에 없었다.** 문서가 겹쳐 적힌 것이 곧 신호였다.
CHILDCARE_SAFETY_URL=
CHILDCARE_SAFETY_SERVICE_NAME=

# ── 공통 동작 설정 (키 아님 — 실값 커밋 가능) ───────────────────────────────

EXTERNAL_API_TIMEOUT_SEC=5        # 외부 호출 타임아웃 (C-3.3 — 무제한 금지)
EXTERNAL_API_RETRY=1              # 재시도 1회. 실패 시 영상 단독 판정으로 저하 운전
EXTERNAL_API_CACHE_TTL_SEC=300    # 컨텍스트 캐시. 특보는 5분이면 충분
EXTERNAL_API_ENABLED=false        # ★ 기본 false. 어댑터 완성·실측 후 개별 활성화

# ── 등재하지 않은 것 (D-298) ────────────────────────────────────────────────
#   제외: NEIS · 대구교육청 방과후학교 · Open DART · 국세청 사업자등록 ·
#         금융위 4종 · 관세청 수출입 · 가맹사업 · 소상공인 상가 ·
#         범죄정보(개인정보 부담) — 제품 도메인과 무관
#   P2 예약: 건축HUB(18) · 토지이용규제(19) → 시설물 App(향후 슬롯). 계약 범위 밖
#   저장소 밖: 조달청 나라장터 3종(14/15/21) — 지자체 입찰 모니터링에 유용하나
#             제품 기능이 아니므로 코드에 넣지 않는다. 대표 참고사항으로만.
#   쓰지 않을 변수를 두면 다음 사람이 "왜 있지" 를 묻게 된다 — 그래서 등재하지 않는다.
