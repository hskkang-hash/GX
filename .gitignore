# 패키지 매니저: npm 정본 (D-006). package-lock.json 은 추적하고 yarn.lock 은 막는다.
frontend/yarn.lock
/frontend/yarn.lock
yarn.lock
.package-lock.json
backend/celery_beat.log
backend/celery_worker.log
backend/scripts/processed_raw_data.json
gateway/build_gateway.sh

*.log
*.coverage
*.pem

# 환경 파일 (W0-0) — *.env 패턴은 .env.stg 를 잡지 못한다(접미사 불일치).
# 스테이징/운영 실값 파일은 애초에 커밋 대상이 아니다. 템플릿은 .env*.example 만 추적한다.
.env
.env.*
**/.env.*
!.env*.example
!**/.env*.example

# 시크릿 (D-002) — 실키 백업은 저장소 밖 ~/.guardianx-secrets/ 에 둔다.
# 아래는 실수로 저장소 안에 만들었을 때를 대비한 방어선이다.
.guardianx-secrets/
**/.guardianx-secrets/
*.7z
secrets.*
!secrets.example.*

# D-354 백업 산출물 — **대조표와 복구 기록은 커밋하고, 덤프 자체는 커밋하지 않는다.**
# 덤프에는 운영 데이터가 들어 있고(계약 11조 · D-269), 4MB 짜리 이진 파일은
# 저장소가 아니라 백업 저장소의 것이다. 복구가 성공했다는 **증거**는 남는다.
docs/agent/evidence/D-354/backup/*.dump
docs/agent/evidence/D-354/backup/objects/

# 브라우저 캡처용으로 컨테이너에 심는 프런트 산출물 (D-386).
# `gx-shell` 의 /app 이 이 디렉터리라서 여기 생긴다 — **빌드 산출물이므로 추적하지 않는다.**
backend/_fe_dist/
# ★ [2026-09-04] 차선마다 자기 번들을 심는다(`_fe_dist_d` · `_fe_dist_c` …).
#   접두로 막지 않으면 **시크릿 게이트가 빨개진다** — 번들에는 지도 API 키가 구워져
#   들어가고, 그 파일이 저장소에 실리면 「저장소가 나른다」가 된다 [실측 09-04].
backend/_fe_dist*/

# 고정 설치된 외부 도구 (scripts/secret_scanner.lock.json) — 저장소가 드는 것은 lock 이지 물건이 아니다
tools/

# ── OPS-13 앞단 관문은 **생성물이다** ────────────────────────────────────
# 정본은 `backend/common/access_gate.py` 의 목록이고 생성기는 `common/front_line.py`.
# 만들어진 설정을 저장소에 담으면 목록이 두 벌이 되고, 두 벌은 반드시 어긋난다(D-369).
# 앞단을 세울 때 `scripts/ops_front_line.py --render` 로 그 자리에서 만든다.
nginx/generated/

# P-136 — 원격이 열리는 날 첫 push 를 5분으로 만드는 git bundle(저장소 전체의 사본).
# 저장소가 자기 사본을 나르지 않는다 — 번들은 저장소 밖으로 옮겨 쓰는 물건이다.
docs/agent/evidence/bundles/*.bundle
